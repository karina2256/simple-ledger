{
  "name": "daily-ledger",
  "version": "0.1.0",
  "description": "记账簿 · 本地离线记账桌面应用",
  "main": "./out/main/index.js",
  "private": true,
  "author": "daily-ledger",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild": "electron-builder install-app-deps",
    "setup": "node scripts/setup.mjs",
    "setup:native": "node scripts/fetch-native.mjs",
    "selftest": "electron-vite build && node scripts/selftest.mjs",
    "verify:upgrade": "electron-vite build && node scripts/verify-upgrade.mjs",
    "smoke:pages": "electron-vite build && node scripts/page-smoke.mjs",
    "verify:motion": "electron-vite build && node scripts/verify-motion.mjs",
    "verify:billshot": "electron-vite build && node scripts/verify-billshot.mjs",
    "shots": "electron-vite build && node scripts/page-smoke.mjs --shots docs/screenshots",
    "seed:demo": "electron-vite build && node scripts/seed-demo.mjs",
    "build:win": "electron-vite build && node scripts/build-win.mjs",
    "icons": "node scripts/make-icons.mjs",
    "verify:packaged": "node scripts/verify-packaged.mjs",
    "setup:ocr": "node scripts/setup-ocr.mjs",
    "verify:ocr": "electron-vite build && node scripts/verify-ocr.mjs",
    "verify:exchange": "electron-vite build && node scripts/run-probe.mjs LEDGER_EXCHANGE_PROBE",
    "verify:security": "electron-vite build && node scripts/run-probe.mjs LEDGER_SECURITY_PROBE",
    "verify:update": "electron-vite build && node scripts/run-probe.mjs LEDGER_UPDATE_PROBE",
    "verify:site": "node scripts/verify-site.mjs",
    "site": "node scripts/serve-site.mjs",
    "course": "node scripts/build-course-pdf.mjs",
    "verify:course": "node scripts/build-course-pdf.mjs && node scripts/verify-course.mjs"
  },
  "dependencies": {
    "better-sqlite3": "12.4.1",
    "onnxruntime-node": "^1.30.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "electron": "34.5.8",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  }
}
